{{!--
  Render mermaid diagrams. A block processor, for example
  product-docs-common/extensions/mermaid-block/mermaid-block.js, writes each
  diagram source into a <div class="mermaid">. This script loads mermaid only
  on pages that contain a diagram.

  Diagrams use the SUSE font, as the PDF diagrams do. mermaid measures the
  labels when it draws, so the script waits for the font first.

  A site that uses @sntke/antora-mermaid-extension replaces this partial with
  its own script, which has the same stem.
--}}
<script type="module">
  const diagrams = document.querySelectorAll(".mermaid");
  if (diagrams.length) {
    const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@10.9.6/dist/mermaid.esm.min.mjs");
    const fontFamily = '"SUSE", sans-serif';
    await document.fonts.load('16px "SUSE"').catch(() => {});
    mermaid.initialize({ startOnLoad: false, fontFamily, themeVariables: { fontFamily } });
    await mermaid.run({ nodes: diagrams });
  }
</script>
